{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Base config. Shared keys (compatibility_date, observability) are inherited
  // by every named environment below. Always deploy with an explicit `--env`.
  "name": "satellitehr-poc",
  "compatibility_date": "2026-06-01",
  "observability": {
    "enabled": true
  },
  // Static SPA hosting via Workers Assets. `single-page-application` rewrites
  // unknown paths to index.html so TanStack Router can handle client routing.
  "env": {
    "dev": {
      "name": "satellitehr-poc-dev",
      "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application"
      }
    },
    "staging": {
      "name": "satellitehr-poc-staging",
      "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application"
      }
    },
    "production": {
      "name": "satellitehr-poc-production",
      "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application"
      }
    }
  }
}
